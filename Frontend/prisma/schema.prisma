// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  password      String    @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")
  
  sessions      Session[]
  analyses      Analysis[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @db.VarChar(500) @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
  @@index([sessionToken])
  @@index([expires])
}

model Analysis {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Video metadata
  fileName     String   @db.VarChar(500) @map("file_name")
  exerciseType String   @db.VarChar(100) @map("exercise_type")

  // Video storage (stored as binary data in PostgreSQL)
  inputVideo   Bytes?   @map("input_video")
  inputVideoSize Int?   @map("input_video_size")
  inputVideoMimeType String? @db.VarChar(100) @default("video/mp4") @map("input_video_mime_type")
  
  outputVideo  Bytes?   @map("output_video")
  outputVideoSize Int?  @map("output_video_size")
  outputVideoMimeType String? @db.VarChar(100) @default("video/mp4") @map("output_video_mime_type")

  // Processing status
  status       String   @db.VarChar(50) @default("pending")
  progress     Decimal? @default(0) @db.Decimal(3, 2)
  errorMessage String?  @map("error_message")

  // Analysis results
  overallScore Decimal? @map("overall_score") @db.Decimal(5, 2)
  maxScore     Decimal? @map("max_score") @db.Decimal(5, 2)
  percentage   Decimal? @db.Decimal(5, 2)
  resultsJson  Json?    @map("results_json")

  // Generated reports (stored as binary)
  pdfReport    Bytes?   @map("pdf_report")
  pdfReportSize Int?    @map("pdf_report_size")
  
  jsonReport   Json?    @map("json_report")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@map("analyses")
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([exerciseType])
}
